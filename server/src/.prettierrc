{
    "bracketSameLine": false,
    "bracketSpacing": true,
    "printWidth": 250,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "useTabs": false,
    "plugins": [
        "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/index.css"
}